# config.env — настройки под себя
# ================================

# Логин/пароль для клиентов, подключающихся к SOCKS5-шлюзу
GATEWAY_USER=polo
GATEWAY_PASSWORD=polo

# Порт, который будут использовать клиентские устройства
GATEWAY_PORT=1080

# Автообновление кода из GitHub при каждом запуске (1 = да, 0 = нет)
AUTO_UPDATE=1

# Автоматический перезапуск Tor, если он неожиданно упал (1 = да, 0 = нет)
AUTO_RESTART=1

# Что попадает в лог шлюза (tor_socks_gateway.py):
#   off     — ничего идентифицирующего: ни IP клиентов, ни адресов сайтов
#             (только факт ошибок без деталей). Рекомендуется для приватности.
#   minimal — факт событий (подключился/отключился/ошибка), но без адресов
#   verbose — полные логи с IP и адресами назначения, только для отладки
LOG_MODE=off

# Полная зачистка состояния Tor (кэш узлов, guard-ноды) перед каждым
# запуском. Не снижает скорость уже работающих соединений — влияет
# только на время первоначального bootstrap (может занять дольше).
# 1 = да, 0 = нет (по умолчанию)
PARANOID_WIPE_STATE=0

# Отключить служебный padding-трафик Tor (небольшая экономия трафика
# и накладных расходов) ценой части защиты от анализа по объёму/
# таймингам пакетов. Для домашнего использования обычно не критично.
# 1 = да, 0 = нет, оставить защиту (по умолчанию)
DISABLE_CONN_PADDING=0
